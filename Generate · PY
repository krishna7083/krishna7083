"""Generates assets/banner-dark.svg and assets/banner-light.svg
Run:  python scripts/banner/generate.py
Edit LINES / PIPELINE below to change the content."""
import random, pathlib, html

W, H = 1000, 470
T = 22.0  # loop length (s)
MONO = "ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, 'Liberation Mono', monospace"

# (key, value, value_color_role)  -- key None => full-width command line
LINES = [
    (None, "./profile.sh --live", "cmd"),
    ("ok", "connected to personalization-platform ... done", "ok"),
    ("name", "Krushna Oza", "hi"),
    ("role", "Software Engineer @ JPMorgan Chase & Co.", "val"),
    ("location", "Hyderabad, Telangana, India", "val"),
    ("stack", "Java · Python · Go · Spark · Kafka · AWS", "val"),
    ("focus", "Data Eng · ML Recsys · Cloud · MCP Servers", "val"),
    ("now", "turning millions of txns → insights", "val"),
    ("status", "online", "status"),
]
PIPELINE = [("TCS", "fresher"), ("Reliance Jio", "telecom scale"),
            ("TechMojo", "senior SDE"), ("JPMorgan Chase", "fintech @ scale")]

THEMES = {
 "dark": dict(bg1="#0d1117", bg2="#0a192f", border="#1f2a44", bar="#111a2e", title="#8b9bb8",
              text="#e2e8f0", key="#60a5fa", hi="#ffffff", val="#cbd5e1", ok="#34d399",
              prompt="#34d399", accent="#1a56db", accent2="#60a5fa", dim="#2b3a5c", glow="#1a56db",
              glowop="0.28", sub="#7f93b5"),
 "light": dict(bg1="#ffffff", bg2="#eef4ff", border="#d0d7de", bar="#f1f5fb", title="#57606a",
              text="#1f2328", key="#1a56db", hi="#0b1f4d", val="#334155", ok="#047857",
              prompt="#047857", accent="#1a56db", accent2="#1a56db", dim="#c2cfe6", glow="#1a56db",
              glowop="0.14", sub="#57606a"),
}

def build(name, c):
    css, body = [], []
    start0, gap, dur = 0.6, 1.2, 0.9
    for i, (k, v, role) in enumerate(LINES):
        y = 84 + (0 if i == 0 else 28 + (i - 1) * 26 + (0 if i < 2 else 10))
        s = (start0 + i * gap) / T * 100
        e = (start0 + i * gap + dur) / T * 100
        nchar = len(v) + (0 if k is None else 12)
        wpx = 32 + nchar * 9.4 + 20
        css.append(f"@keyframes t{i}{{0%{{width:0}}{s:.2f}%{{width:0}}{e:.2f}%{{width:{wpx:.0f}px}}96%{{width:{wpx:.0f}px}}100%{{width:0}}}}"
                   f"#c{i} rect{{animation:t{i} {T}s steps({max(nchar,8)},end) infinite}}")
        body.append(f'<clipPath id="c{i}"><rect x="0" y="{y-18}" width="0" height="26"/></clipPath>')
        g = [f'<g clip-path="url(#c{i})">']
        if k is None:
            g.append(f'<text x="32" y="{y}" class="mono prompt">$</text><text x="52" y="{y}" class="mono hi">{html.escape(v)}</text>')
        else:
            if role == "ok":
                g.append(f'<text x="32" y="{y}" class="mono ok">✔</text><text x="56" y="{y}" class="mono ok">{html.escape(v)}</text>')
            else:
                g.append(f'<text x="32" y="{y}" class="mono key">{k}</text><text x="128" y="{y}" class="mono dimk">:</text>')
                if role == "status":
                    g.append(f'<circle cx="153" cy="{y-5}" r="5" fill="{c["ok"]}"><animate attributeName="opacity" values="1;.25;1" dur="1.6s" repeatCount="indefinite"/></circle>'
                             f'<text x="168" y="{y}" class="mono ok">{v}</text>')
                else:
                    g.append(f'<text x="146" y="{y}" class="mono {role}">{html.escape(v)}</text>')
        g.append('</g>')
        body.append("".join(g))
    # live bar chart
    rnd = random.Random(7)
    bars = [f'<text x="712" y="84" class="mono key" font-size="13">txn.stream ▸ live</text>']
    base, maxh, bw, gp, x0 = 262, 130, 14, 5, 712
    for b in range(13):
        vals = [rnd.randint(28, maxh) for _ in range(5)]; vals.append(vals[0])
        hs = ";".join(map(str, vals)); ys = ";".join(str(base - v) for v in vals)
        d = rnd.uniform(2.6, 4.4)
        op = 0.55 + 0.45 * (b / 12)
        bars.append(f'<rect x="{x0+b*(bw+gp)}" y="{base-vals[0]}" width="{bw}" height="{vals[0]}" rx="2" fill="url(#bar)" opacity="{op:.2f}">'
                    f'<animate attributeName="height" values="{hs}" dur="{d:.1f}s" repeatCount="indefinite"/>'
                    f'<animate attributeName="y" values="{ys}" dur="{d:.1f}s" repeatCount="indefinite"/></rect>')
    bars.append(f'<line x1="{x0-4}" y1="{base+2}" x2="{x0+13*(bw+gp)}" y2="{base+2}" stroke="{c["dim"]}"/>')
    bars.append(f'<text x="{x0}" y="{base+22}" class="mono sub" font-size="12">millions of txns / day</text>')
    # pipeline
    py, xs = 400, [130, 370, 610, 850]
    pipe = [f'<line x1="32" y1="342" x2="968" y2="342" stroke="{c["dim"]}" stroke-dasharray="2 5"/>',
            f'<text x="32" y="366" class="mono key" font-size="13">career.pipeline</text>',
            f'<line x1="{xs[0]}" y1="{py}" x2="{xs[-1]}" y2="{py}" stroke="{c["dim"]}" stroke-width="2"/>',
            f'<line x1="{xs[0]}" y1="{py}" x2="{xs[-1]}" y2="{py}" stroke="{c["accent2"]}" stroke-width="2" stroke-dasharray="6 12">'
            f'<animate attributeName="stroke-dashoffset" from="36" to="0" dur="1.6s" repeatCount="indefinite"/></line>']
    for j, (n, s) in enumerate(PIPELINE):
        last = j == len(PIPELINE) - 1
        pipe.append(f'<circle cx="{xs[j]}" cy="{py}" r="8" fill="{c["bg1"]}" stroke="{c["accent2"]}" stroke-width="2"/>')
        if last:
            pipe.append(f'<circle cx="{xs[j]}" cy="{py}" r="8" fill="none" stroke="{c["accent2"]}"><animate attributeName="r" values="8;20;8" dur="2.4s" repeatCount="indefinite"/>'
                        f'<animate attributeName="opacity" values=".8;0;.8" dur="2.4s" repeatCount="indefinite"/></circle>'
                        f'<circle cx="{xs[j]}" cy="{py}" r="4" fill="{c["accent2"]}"/>')
        pipe.append(f'<text x="{xs[j]}" y="{py+28}" text-anchor="middle" class="mono {"hi" if last else "val"}" font-size="14">{n}</text>')
        pipe.append(f'<text x="{xs[j]}" y="{py+45}" text-anchor="middle" class="mono sub" font-size="11">{s}</text>')
    pipe.append(f'<circle r="4" fill="{c["hi"] if name=="dark" else c["accent"]}"><animateMotion dur="5s" repeatCount="indefinite" path="M{xs[0]},{py} L{xs[-1]},{py}"/></circle>')

    return f'''<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {W} {H}" width="{W}" height="{H}" role="img" aria-label="Krushna Oza terminal profile">
<defs>
<linearGradient id="bg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="{c["bg1"]}"/><stop offset="1" stop-color="{c["bg2"]}"/></linearGradient>
<radialGradient id="glow" cx="0.82" cy="0.2" r="0.6"><stop offset="0" stop-color="{c["glow"]}" stop-opacity="{c["glowop"]}"/><stop offset="1" stop-color="{c["glow"]}" stop-opacity="0"/></radialGradient>
<linearGradient id="bar" x1="0" y1="1" x2="0" y2="0"><stop offset="0" stop-color="{c["accent"]}"/><stop offset="1" stop-color="{c["accent2"]}"/></linearGradient>
{"".join(x for x in body if x.startswith("<clipPath"))}
</defs>
<style>
.mono{{font-family:{MONO};font-size:15px}}
.prompt{{fill:{c["prompt"]};font-weight:700}} .hi{{fill:{c["hi"]};font-weight:700}} .key{{fill:{c["key"]}}}
.val{{fill:{c["val"]}}} .ok{{fill:{c["ok"]}}} .sub{{fill:{c["sub"]}}} .dimk{{fill:{c["dim"]}}} .cmd{{fill:{c["hi"]}}}
{"".join(css)}
@media (prefers-reduced-motion:reduce){{*{{animation:none!important}}}}
</style>
<rect x="1" y="1" width="{W-2}" height="{H-2}" rx="14" fill="url(#bg)" stroke="{c["border"]}" stroke-width="2"/>
<rect x="1" y="1" width="{W-2}" height="{H-2}" rx="14" fill="url(#glow)"/>
<path d="M1 44 V15 a14 14 0 0 1 14 -14 H{W-15} a14 14 0 0 1 14 14 V44 Z" fill="{c["bar"]}"/>
<line x1="1" y1="44" x2="{W-1}" y2="44" stroke="{c["border"]}"/>
<circle cx="28" cy="23" r="6" fill="#ff5f56"/><circle cx="50" cy="23" r="6" fill="#ffbd2e"/><circle cx="72" cy="23" r="6" fill="#27c93f"/>
<text x="{W/2}" y="28" text-anchor="middle" class="mono" font-size="13" fill="{c["title"]}">krushna@jpmc: ~/profile — ./profile.sh --live</text>
{"".join(x for x in body if not x.startswith("<clipPath"))}
{"".join(bars)}
{"".join(pipe)}
</svg>'''

out = pathlib.Path(__file__).resolve().parents[2] / "assets"
out.mkdir(exist_ok=True)
for n, c in THEMES.items():
    (out / f"banner-{n}.svg").write_text(build(n, c), encoding="utf-8")
    print("wrote", out / f"banner-{n}.svg")
